# Copy to .env and fill in. NEVER commit .env.
# Model names live here so they can change without code edits.

# --- LLM providers (create free keys) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
LLM_TERTIARY_MODEL=

# --- Data stores ---
DATABASE_URL=postgresql://user:password@localhost:5432/dharohar
REDIS_URL=redis://localhost:6379/0
# SQLite seed DB for monuments (relative paths resolve from backend/)
SQLITE_DB_PATH=data/raahein.db

# --- Web ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Maps / routing ---
ORS_API_KEY=
# Identifying User-Agent required by Nominatim/OSM services (use a real contact)
OSM_USER_AGENT=dharohar/0.1 (contact: your-email@example.com)
